{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Jogar Fish Hunter",
      "type": "shell",
      "command": "${workspaceFolder}/run.sh",
      "windows": {
        "command": "${workspaceFolder}/run.bat"
      },
      "osx": {
        "command": "chmod +x ${workspaceFolder}/run.sh && ${workspaceFolder}/run.sh"
      },
      "linux": {
        "command": "chmod +x ${workspaceFolder}/run.sh && ${workspaceFolder}/run.sh"
      },
      "problemMatcher": [],
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true,
        "panel": "shared",
        "showReuseMessage": true,
        "clear": false
      }
    }
  ]
}
